+// Fallback lookup for API credentials when per-account UI fields are empty.
+//   1. env vars TELEGRAM_API_ID / TELEGRAM_API_HASH
+//   2. file <purple_user_dir>/telegram-tdlib-api.conf with:
+//        api_id=12345
+//        api_hash=0123456789abcdef0123456789abcdef
+// Returns source name on hit (sets api_id/api_hash), nullptr otherwise.
+static const char *loadRuntimeApiCredentials(int &api_id, std::string &api_hash)
+{
+    const char *envId   = getenv("TELEGRAM_API_ID");
+    const char *envHash = getenv("TELEGRAM_API_HASH");
+    if (envId && *envId && envHash && *envHash) {
+        int id = atoi(envId);
+        if (id > 0) { api_id = id; api_hash = envHash; return "environment"; }
+    }
+    std::string path = std::string(purple_user_dir()) + G_DIR_SEPARATOR_S + "telegram-tdlib-api.conf";
+    std::ifstream f(path);
+    if (!f.is_open()) return nullptr;
+
+    int fileId = 0; std::string fileHash, line;
+    while (std::getline(f, line)) {
+        size_t start = line.find_first_not_of(" \t");
+        if (start == std::string::npos || line[start] == '#') continue;
+        size_t eq = line.find('=', start);
+        if (eq == std::string::npos) continue;
+        std::string key = line.substr(start, eq - start);
+        std::string val = line.substr(eq + 1);
+        key.erase(key.find_last_not_of(" \t") + 1);
+        size_t vs = val.find_first_not_of(" \t");
+        if (vs == std::string::npos) continue;
+        val = val.substr(vs);
+        val.erase(val.find_last_not_of(" \t\r\n") + 1);
+        if (key == "api_id")        fileId   = atoi(val.c_str());
+        else if (key == "api_hash") fileHash = val;
+    }
+    if (fileId > 0 && !fileHash.empty()) {
+        api_id = fileId; api_hash = fileHash;
+        return "telegram-tdlib-api.conf";
+    }
+    return nullptr;
+}
